# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=veridex_user
DB_PASSWORD=veridex_password
DB_NAME=veridex_db

# FREE LLM PROVIDER OPTIONS (Choose any one):
# Option 1: FREE Groq API (Get key for free at https://console.groq.com)
GROQ_API_KEY=gsk_your_free_groq_api_key_here

# Option 2: FREE OpenRouter API (Get free key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Option 3: Standard OpenAI API Key
OPENAI_API_KEY=

# Live Weather API (wttr.in requires ZERO keys and works out-of-the-box!)
WEATHER_API_KEY=mock-key

# data.gov.in Official API Key (Get key at https://data.gov.in)
DATAGOV_API_KEY=

# Data Mode (live = strict no-fake-data mode; demo = allows mock fallback records)
DATA_MODE=live

# Background Live Ingestion Interval in Minutes
INGESTION_INTERVAL_MINUTES=10
